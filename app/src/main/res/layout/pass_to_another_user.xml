<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="#9DB1CC"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/textView"
        android:layout_width="333dp"
        android:layout_height="254dp"
        android:layout_marginTop="50.dp"
        android:gravity="center_horizontal"
        android:text="Передай устройство другому пользователю"
        android:textColor="#252850"
        android:textSize="35.sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/nextBtn"
        android:layout_width="219dp"
        android:layout_height="78dp"
        android:layout_marginBottom="50.dp"
        android:text="ВПЕРЕД"
        android:backgroundTint="#252850"
        android:textColor="#9DB1CC"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>