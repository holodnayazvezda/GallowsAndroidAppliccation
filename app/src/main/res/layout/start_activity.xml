<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9DB1CC"
    tools:context=".gui.StartActivity">

    <TextView
        android:id="@+id/infoTextView"
        android:layout_width="297dp"
        android:layout_height="96dp"
        android:layout_marginTop="50.dp"
        android:gravity="center_horizontal"
        android:text="Привет, готов отгадывать слова?)"
        android:textColor="#252850"
        android:textSize="30.sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/startBtn"
        android:layout_width="250dp"
        android:layout_height="80dp"
        android:layout_marginTop="300.dp"
        android:backgroundTint="#252850"
        android:textColor="#9DB1CC"
        android:text="ПОГНАЛИ"
        android:textSize="20.sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/infoTextView" />

    <Button
        android:id="@+id/rulesBtn"
        android:layout_width="180dp"
        android:layout_height="80dp"
        android:layout_marginTop="30.dp"
        android:backgroundTint="#252850"
        android:textColor="#9DB1CC"
        android:text="Правила"
        android:textSize="17.sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/startBtn" />
</androidx.constraintlayout.widget.ConstraintLayout>